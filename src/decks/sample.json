{
  "id": "sample-algebra-2026-05",
  "name": "Algebra Sampler",
  "createdAt": "2026-05-02",
  "cards": [
    {
      "front": "What is the **quadratic formula**?",
      "back": "$$x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$$"
    },
    {
      "front": "Define *slope*.",
      "back": "The ratio $\\frac{\\Delta y}{\\Delta x}$ — how steep a line is."
    },
    {
      "front": "Solve: $2x + 6 = 14$",
      "back": "$x = 4$"
    },
    {
      "front": "What does $a^0$ equal for any nonzero $a$?",
      "back": "$a^0 = 1$"
    },
    {
      "front": "Expand: $(x+3)(x-2)$",
      "back": "$x^2 + x - 6$"
    }
  ]
}
